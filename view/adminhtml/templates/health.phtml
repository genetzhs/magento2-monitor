<?php
/**
 * Store health — the same overview as the MageSentinel WordPress plugin.
 *
 * @var \MageSentinel\Monitor\Block\Adminhtml\Health $block
 * @var \Magento\Framework\Escaper $escaper
 */
$rows = $block->getSortedRows();
$v = $block->getVerdict();
$conn = $block->getConnection();
$free = $block->getFreeTest();
$sales = $block->getSales();
$s = $sales->last24h();
$tests = $sales->tests();
$week = $sales->week();
$slots = $sales->hourSlots();
$rev = $sales->revenueWeeks();
$today = $s['orders'];
$delta = $today - $s['last_week'];
$peakSlot = null;
foreach ($slots as $slot) {
    if ($today > 0 && ($peakSlot === null || $slot['count'] > $peakSlot['count'])) {
        $peakSlot = $slot;
    }
}
$revThis = array_sum($rev['this']);
$revLast = array_sum($rev['last']);
$revPct = $revLast > 0 ? (int)round(($revThis - $revLast) / $revLast * 100) : null;
$speed = $block->getSpeedRuns();
$speedMs = array_values(array_filter(array_map(static function ($r) {
    return (int)($r['ms'] ?? 0);
}, $speed)));
$speedMed = 0;
if ($speedMs) {
    $sorted = $speedMs;
    sort($sorted);
    $mid = intdiv(count($sorted), 2);
    $speedMed = count($sorted) % 2 ? $sorted[$mid] : (int)(($sorted[$mid - 1] + $sorted[$mid]) / 2);
}
$speedScale = max(20000, $speedMs ? (int)(ceil(max($speedMs) / 10000) * 10000) : 20000);
$lastSpeed = $speed ? end($speed) : null;
$hdays = $block->getHealthDays();
$pill = ['on' => ['good', __('Monitored by MageSentinel')], 'quiet' => ['watch', __('Set up, not checking in')], 'off' => ['off', __('Not connected')]][$conn];
$freeUsed = $conn === 'off' && !empty($free['next']) && (int)$free['next'] > time();
?>
