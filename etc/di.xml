<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="MageSentinel\Monitor\Api\DiagnosticsInterface"
                type="MageSentinel\Monitor\Model\Diagnostics"/>
    <preference for="MageSentinel\Monitor\Api\OrderCleanupInterface"
                type="MageSentinel\Monitor\Model\OrderCleanup"/>
    <preference for="MageSentinel\Monitor\Api\ProofInterface"
                type="MageSentinel\Monitor\Model\Proof"/>
    <!-- The merchant's opt-in CAPTCHA exemption for MageSentinel's own checks.
         Inert unless allow_captcha_skip is on and the request carries the store's token. -->
    <type name="Magento\ReCaptchaUi\Model\IsCaptchaEnabledInterface">
        <plugin name="magesentinel_skip_recaptcha"
                type="MageSentinel\Monitor\Plugin\SkipCaptchaForTrustedCheck"/>
    </type>
    <type name="Magento\Captcha\Model\DefaultModel">
        <plugin name="magesentinel_skip_captcha"
                type="MageSentinel\Monitor\Plugin\SkipCaptchaForTrustedCheck"/>
    </type>
    <!-- The hidden test payment method: visible only to MageSentinel's own checks (token + opt-in). -->
    <type name="Magento\Payment\Model\MethodList">
        <plugin name="magesentinel_test_method_list" type="MageSentinel\Monitor\Plugin\TestMethodAvailability"/>
    </type>
    <type name="MageSentinel\Monitor\Model\Payment\TestMethod">
        <plugin name="magesentinel_test_method_available" type="MageSentinel\Monitor\Plugin\TestMethodAvailability"/>
    </type>
    <type name="Magento\Sales\Model\ResourceModel\Order\Grid\Collection">
        <plugin name="magesentinel_hide_test_orders" type="MageSentinel\Monitor\Plugin\HideTestOrdersFromGrid"/>
    </type>
</config>
